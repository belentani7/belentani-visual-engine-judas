{
  "name": "belentani-visual-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Belentani Visual Engine — Lore/Code → Three.js Procedural Visual Experiences",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev:api",
    "dev:all": "turbo run dev dev:api",
    "build": "turbo run build",
    "build:api": "turbo run build:api",
    "build:desktop": "turbo run build:desktop",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:visual": "turbo run test:visual",
    "test:perf": "turbo run test:perf",
    "validate:spec": "python tools/validate-spec.py SPEC.md",
    "validate:shaders": "python tools/validate-shaders.py",
    "validate:convergence": "python tools/check-spec-convergence.py --spec SPEC.md --diff HEAD~1..HEAD",
    "audit": "python tools/audit-production-readiness.py --repo . --level 2",
    "apply:checklist": "python tools/apply-production-checklist.py --all --level 2 --push --deploy",
    "deploy:preview": "turbo run deploy:preview",
    "deploy:prod": "turbo run deploy:prod",
    "studio:dev": "turbo run studio:dev",
    "studio:build": "turbo run studio:build",
    "generate:planet": "turbo run generate:planet --filter=generators",
    "generate:diamond": "turbo run generate:diamond --filter=generators"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "axe-core": "^4.9.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vitest": "^0.5.4",
    "lighthouse": "^11.0.0",
    "prettier": "^3.9.8",
    "prettier-plugin-organize-imports": "^4.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.8.0",
  "keywords": [
    "threejs",
    "webgpu",
    "tsl",
    "procedural",
    "visual-engine",
    "belentani",
    "lore-to-visual"
  ],
  "author": "Belentani",
  "license": "MIT"
}
