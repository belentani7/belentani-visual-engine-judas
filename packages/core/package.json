{
  "name": "@belentani/core",
  "version": "1.0.0",
  "description": "Shared types, Zod schemas, and branded types for Belentani Visual Engine",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./lore-schema": {
      "types": "./dist/lore-schema.d.ts",
      "import": "./dist/lore-schema.mjs",
      "require": "./dist/lore-schema.js"
    },
    "./parameter-types": {
      "types": "./dist/parameter-types.d.ts",
      "import": "./dist/parameter-types.mjs",
      "require": "./dist/parameter-types.js"
    },
    "./scene-schema": {
      "types": "./dist/scene-schema.d.ts",
      "import": "./dist/scene-schema.mjs",
      "require": "./dist/scene-schema.js"
    },
    "./generator-types": {
      "types": "./dist/generator-types.d.ts",
      "import": "./dist/generator-types.mjs",
      "require": "./dist/generator-types.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc -w",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:schemas": "tsx scripts/validate-schemas.ts"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "zod": "^3.23.0",
    "tsx": "^4.16.0"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "sideEffects": false
}